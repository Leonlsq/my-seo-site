---
export async function getStaticPaths() {
  // 使用原生的 import.meta.glob 替代 Astro.glob
  const posts = import.meta.glob('../markdown/*.md', { eager: true });
  
  return Object.entries(posts).map(([filePath, post]) => {
    // 从路径提取文件名作为网页链接后缀 (slug)
    const fileName = filePath.split('/').pop().replace('.md', '');
    return {
      params: { slug: fileName },
      props: { post },
    };
  });
}

const { post } = Astro.props;
// 读取 Markdown 生成的内容和顶部数据
const { Content, frontmatter } = post as any;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{frontmatter.title}</title>
    <meta name="description" content={frontmatter.description} />
    <style>
      body { font-family: system-ui, sans-serif; line-height: 1.6; max-width: 800px; margin: 0 auto; padding: 2rem; color: #333; }
      h1 { color: #1a1a1a; }
      .ad-banner { background: #f4f4f4; border: 1px dashed #ccc; padding: 1rem; text-align: center; margin: 2rem 0; color: #666;}
      /* 给链接加一点样式，让它看起来更像一个可点击的按钮 */
      .ad-banner a { color: #0056b3; font-weight: bold; text-decoration: underline; }
      .ad-banner a:hover { color: #ff4500; }
    </style>
  </head>
  <body>
    <header>
      <a href="/" style="color: blue; text-decoration: none;">← 返回首页</a>
    </header>

    <main>
      <h1>{frontmatter.title}</h1>
      
        <!-- 你的专属 Make Affiliate 广告位 -->
        <div class="ad-banner">
        💡 Want to automate your own workflow? Try Make.com for free today! <a href="https://www.make.com/en/register?pc=automatethatwithai" target="_blank" rel="noopener noreferrer">Click here</a>
        </div>
        
      <Content />
    </main>
  </body>
</html>