---
export async function getStaticPaths() {
  const posts = import.meta.glob('../markdown/*.md', { eager: true });
  
  return Object.entries(posts).map(([filePath, post]) => {
    const fileName = filePath.split('/').pop().replace('.md', '');
    return {
      params: { slug: fileName },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content, frontmatter } = post as any;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{frontmatter.title}</title>
    <meta name="description" content={frontmatter.description} />
    
    <!-- 💰 Google AdSense 全局自动广告脚本 (新加入) -->
    <!-- 注意：等你申请了 AdSense，把下面链接里的 ca-pub-xxx 换成你自己的真实 ID -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1234567890123456" crossorigin="anonymous"></script>

    <style>
      body { font-family: system-ui, sans-serif; line-height: 1.8; max-width: 800px; margin: 0 auto; padding: 2rem; color: #333; }
      h1 { color: #1a1a1a; font-size: 2.2rem; margin-bottom: 1rem;}
      h2 { color: #222; margin-top: 2rem; border-bottom: 1px solid #eee; padding-bottom: 0.5rem; }
      /* 增加了行高和段落间距，让文章看起来更长，便于 Google 自动插入广告 */
      p { margin-bottom: 1.5rem; }
    </style>
  </head>
  <body>
    <header style="margin-bottom: 2rem;">
      <a href="/" style="color: blue; text-decoration: none; font-weight: bold;">← Back to Home</a>
    </header>

    <main>
      <h1>{frontmatter.title}</h1>
      
      <!-- 删除了之前所有的手工 Affiliate 广告位 -->
      <!-- 网页正文渲染区：Google 的 AI 会自动在这里面的段落之间穿插广告 -->
      <Content />
    </main>
  </body>
</html>